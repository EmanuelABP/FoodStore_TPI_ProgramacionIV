# Ejecutar después de python -m app.db.seed en PostgreSQL de prueba.
# Cambiar el lote para repetir la secuencia y dejar activadas las cookies de REST Client.
@base = http://localhost:8000/api/v1
@lote = productos-c7-01

### 1 Cerrar cualquier sesión (200)
POST {{base}}/auth/logout

### 2 Listado público con paginación por defecto, total e items (200)
GET {{base}}/productos

### 3 Validar el límite de la página (422)
GET {{base}}/productos?limit=101

### 4 Inicio de sesión administrador local (200)
POST {{base}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=admin&password=Admin1234!

### 5 Crear categoría inicial (201)
# @name categoria
POST {{base}}/categorias
Content-Type: application/json

{"nombre":"Inicial {{lote}}"}

### 6 Crear categoría de destino (201)
# @name destino
POST {{base}}/categorias
Content-Type: application/json

{"nombre":"Destino {{lote}}"}

### 7 Crear producto y comprobar la categoría embebida (201)
# @name producto
POST {{base}}/productos
Content-Type: application/json

{"nombre":"Pizza {{lote}}","descripcion":"Masa artesanal","precio_base":12000,"imagen_url":"https://images.pexels.com/photos/10880324/pexels-photo-10880324.jpeg?auto=compress&cs=tinysrgb&w=960","stock":12,"categoria_id":{{categoria.response.body.$.id}}}

### 8 Admitir el mismo nombre en otro producto (201)
# @name otroProducto
POST {{base}}/productos
Content-Type: application/json

{"nombre":"Pizza {{lote}}","precio_base":9000,"categoria_id":{{categoria.response.body.$.id}}}

### 9 Rechazar categoría inexistente al crear (404)
POST {{base}}/productos
Content-Type: application/json

{"nombre":"Producto inválido","precio_base":1,"categoria_id":2147483647}

### 10 Rechazar precio negativo (422)
PUT {{base}}/productos/{{producto.response.body.$.id}}
Content-Type: application/json

{"precio_base":-1}

### 11 Cambiar la categoría y conservar los campos omitidos (200)
PUT {{base}}/productos/{{producto.response.body.$.id}}
Content-Type: application/json

{"categoria_id":{{destino.response.body.$.id}}}

### 12 Editar stock y disponibilidad (200)
PATCH {{base}}/productos/{{producto.response.body.$.id}}/stock
Content-Type: application/json

{"stock":5,"disponible":false}

### 13 Rechazar stock negativo (422)
PATCH {{base}}/productos/{{producto.response.body.$.id}}/stock
Content-Type: application/json

{"stock":-1,"disponible":true}

### 14 Buscar sin distinguir mayúsculas, combinar filtros y comprobar total (200)
GET {{base}}/productos?skip=0&limit=1&search=PIZZA&categoria_id={{destino.response.body.$.id}}&disponible=false

### 15 Segunda página vacía con el mismo total filtrado (200)
GET {{base}}/productos?skip=1&limit=1&search=PIZZA&categoria_id={{destino.response.body.$.id}}&disponible=false

### 16 Dar de baja una categoría con un producto vigente (204)
DELETE {{base}}/categorias/{{destino.response.body.$.id}}

### 17 El producto sigue visible y la categoría embebida tiene activo=false (200)
GET {{base}}/productos/{{producto.response.body.$.id}}

### 18 El producto de categoría inactiva también sigue en el listado (200)
GET {{base}}/productos?categoria_id={{destino.response.body.$.id}}

### 19 Rechazar una categoría inactiva al crear (404)
POST {{base}}/productos
Content-Type: application/json

{"nombre":"Categoría inactiva","precio_base":1,"categoria_id":{{destino.response.body.$.id}}}

### 20 Rechazar reasignar a una categoría inactiva (404)
PUT {{base}}/productos/{{otroProducto.response.body.$.id}}
Content-Type: application/json

{"categoria_id":{{destino.response.body.$.id}}}

### 21 Baja lógica del producto (204)
DELETE {{base}}/productos/{{producto.response.body.$.id}}

### 22 Detalle de producto dado de baja (404)
GET {{base}}/productos/{{producto.response.body.$.id}}

### 23 Cambiar stock de producto dado de baja (404)
PATCH {{base}}/productos/{{producto.response.body.$.id}}/stock
Content-Type: application/json

{"stock":10,"disponible":true}

### 24 Repetir la baja de producto (404)
DELETE {{base}}/productos/{{producto.response.body.$.id}}

### 25 Confirmar acceso público al detalle después del logout (200)
POST {{base}}/auth/logout

### 26 Detalle público sin cookie (200)
GET {{base}}/productos/{{otroProducto.response.body.$.id}}
