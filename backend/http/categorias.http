# Ejecutar en orden después de python -m app.db.seed sobre una base PostgreSQL de prueba.
# Cambiar el lote para repetir las altas. Mantener habilitadas las cookies de REST Client.
@base = http://localhost:8000/api/v1
@lote = categorias-c7-01

### 1 Cerrar la sesión para probar acceso público (200)
POST {{base}}/auth/logout

### 2 Listar categorías activas sin sesión (200)
GET {{base}}/categorias

### 3 Rechazar un alta sin sesión (401)
POST {{base}}/categorias
Content-Type: application/json

{"nombre":"Categoría {{lote}}"}

### 4 Registrar usuario de prueba (201)
POST {{base}}/auth/register
Content-Type: application/json

{"username":"{{lote}}","full_name":"Cliente de catálogo","email":"{{lote}}@example.com","password":"PruebaCatalogo!"}

### 5   Entrar como usuario común (200)
POST {{base}}/auth/token
Content-Type: application/x-www-form-urlencoded

username={{lote}}&password=PruebaCatalogo!

### 6 Rechazar escritura con rol user (403)
POST {{base}}/categorias
Content-Type: application/json

{"nombre":"Categoría {{lote}}"}

### 7 Entrar como administrador local (200)
POST {{base}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=admin&password=Admin1234!

### 8 Crear una categoría (201)
# @name categoria
POST {{base}}/categorias
Content-Type: application/json

{"nombre":"Categoría {{lote}}","descripcion":"Descripción original"}

### 9 Crear otra categoría (201)
# @name otraCategoria
POST {{base}}/categorias
Content-Type: application/json

{"nombre":"Otra categoría {{lote}}"}

### 10 Validar el mínimo del nombre (422)
POST {{base}}/categorias
Content-Type: application/json

{"nombre":"A"}

### 11 Rechazar nombre repetido en el alta (409)
POST {{base}}/categorias
Content-Type: application/json

{"nombre":"Categoría {{lote}}"}

### 12 Obtener el detalle (200)
GET {{base}}/categorias/{{categoria.response.body.$.id}}

### 13 Editar solo la descripción y conservar el nombre (200)
PUT {{base}}/categorias/{{categoria.response.body.$.id}}
Content-Type: application/json

{"descripcion":"Descripción editada"}

### 14 Rechazar nombre repetido en la edición (409)
PUT {{base}}/categorias/{{otraCategoria.response.body.$.id}}
Content-Type: application/json

{"nombre":"Categoría {{lote}}"}

### 15 Dar de baja sin borrar (204)
DELETE {{base}}/categorias/{{categoria.response.body.$.id}}

### 16 Detalle de una categoría inactiva (404)
GET {{base}}/categorias/{{categoria.response.body.$.id}}

### 17 Edición de una categoría inactiva (404)
PUT {{base}}/categorias/{{categoria.response.body.$.id}}
Content-Type: application/json

{"descripcion":"No debe cambiar"}

### 18 Repetir la baja (404)
DELETE {{base}}/categorias/{{categoria.response.body.$.id}}

### 19 El nombre de la categoría dada de baja sigue reservado (409)
POST {{base}}/categorias
Content-Type: application/json

{"nombre":"Categoría {{lote}}"}

### 20 La categoría inactiva no aparece en el listado (200)
GET {{base}}/categorias
