# Conexión de ejemplo a una base PostgreSQL nueva del TPI.
DATABASE_URL=postgresql+psycopg2://postgres:TU_CONTRASENIA@localhost:5432/foodstore_tpi

# Clave aleatoria local de al menos 32 caracteres y 32 bytes UTF-8 para firmar el JWT.
SECRET_KEY=REEMPLAZAR_CON_UNA_CLAVE_ALEATORIA

# Algoritmo de firma del JWT y duración de la sesión en minutos.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend autorizado por CORS.
FRONTEND_ORIGIN=http://localhost:5173
# Lista opcional separada por comas. Si se define, reemplaza FRONTEND_ORIGIN.
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Usar false solo para desarrollo local por HTTP.
COOKIE_SECURE=false
